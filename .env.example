PORT=8080
HOST=0.0.0.0
APP_URL=http://localhost:8080

# logging level
LOG_LEVEL=info

# database path
DB_PATH=data/db/gostreamix.sqlite

# jwt secret
JWT_SECRET=

# proxy header
PROXY_HEADER=

# demo mode: serve a read-only public instance. When true, all mutating
# requests are rejected server-side and a demo account is auto-seeded on boot.
DEMO_MODE=false
DEMO_USERNAME=demo
DEMO_PASSWORD=demostream123
